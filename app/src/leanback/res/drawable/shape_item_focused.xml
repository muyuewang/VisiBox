<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:startColor="@color/glass_fill_strong"
        android:endColor="@color/glass_fill_strong_end" />

    <corners android:radius="14dp" />

    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/accent_glass_edge" />

</shape>