<?xml version="1.0" encoding="utf-8"?>
<!--
    全屏播放控制条面板。
    原来是 glass_fill_strong（#D6FFFFFF，84% 白）的实心玻璃板，
    盖在视频上等于一块不透明的白板，画面下半部分被整块挡掉。
    改成纵向深色渐变：上沿几乎透、越往下越实，既压得住白字，
    又不遮画面；圆角与原来的形状语言保持一致。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp" />
    <gradient
        android:angle="270"
        android:centerColor="@color/control_panel_mid"
        android:centerY="0.35"
        android:endColor="@color/control_panel_bottom"
        android:startColor="@color/control_panel_top"
        android:type="linear" />
</shape>
