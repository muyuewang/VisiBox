<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/glass_fill_strong"
                android:endColor="@color/glass_fill_strong_end" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_glass_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/glass_fill_soft"
                android:endColor="@color/glass_fill_soft_end" />
        </shape>
    </item>
</selector>
