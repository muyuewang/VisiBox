<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中优先于聚焦：选中=绿底，聚焦只在绿底外加白描边 -->
    <item
        android:drawable="@drawable/shape_pill_selected_focus"
        android:state_selected="true"
        android:state_focused="true" />
    <item android:drawable="@drawable/shape_pill_selected" android:state_selected="true" />
    <item android:drawable="@drawable/shape_pill_focus" android:state_focused="true" />
    <item android:drawable="@drawable/shape_pill_normal" />
</selector>
